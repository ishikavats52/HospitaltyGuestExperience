# Hospitality Guest Experience Platform - Production AWS Environment Config

NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Engine Selection ('mongoose' | 'dynamodb')
DB_ENGINE=mongoose

# MongoDB Connection String (If using MongoDB Atlas on AWS)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/hospitality_platform

# AWS DynamoDB Configuration (If DB_ENGINE=dynamodb)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_NAME=HospitalityMainTable

# Cryptographic JWT Secrets
JWT_SECRET=super_secret_hospitality_jwt_key_2026_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=super_secret_refresh_key_2026_production
JWT_REFRESH_EXPIRES_IN=7d

# Cache Configuration
REDIS_URL=redis://localhost:6379
