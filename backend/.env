# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Engine Selection ('dynamodb' | 'mongoose')
DB_ENGINE=dynamodb

# AWS DynamoDB Configuration (Single-Table Design)
# Region ap-south-1 (Mumbai) matches your AWS console table:
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=HospitalityMainTable

# AWS IAM Credentials for account 897021975250 (AgarwalN)
# Provide your AWS Access Key ID and Secret Access Key below:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cryptographic JWT Secrets
JWT_SECRET=super_secret_hospitality_jwt_key_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Cache
REDIS_URL=redis://localhost:6379
